# ---------------------------------------------------------------------------
# Variables de entorno del Portal de Telemetría.
#
# Copiar como `connector/.env` y llenar. El archivo real está en .gitignore y
# NUNCA debe versionarse ni viajar en un ZIP: contiene credenciales vivas.
#
# Las mismas variables marcadas [nube] deben cargarse además en
# Netlify → Site settings → Environment variables, porque las funciones
# serverless no leen este archivo.
# ---------------------------------------------------------------------------

# --- API REST Traffilog v4.3 (obligatorias) -------------------------- [nube]
# Cuenta REGIONAL: 945 unidades · 55 grupos · UDN Guadalajara, Colima y
# Lázaro Cárdenas. Con una cuenta de una sola plaza el portal se ve vacío.
TRAFFILOG_USER=
TRAFFILOG_PASS=
# Endpoint REST. Si se omite, el código usa el valor por defecto de core.mjs.
TRAFFILOG_REST_URL=

# --- Sesiones del portal (obligatoria en nube) ----------------------- [nube]
# Cadena aleatoria larga con la que se firman las cookies de sesión (12 h).
# Generar con:  openssl rand -hex 32
AUTH_SESSION_SECRET=
# Con "1", /api/traffilog exige sesión válida del portal. Recomendado en
# producción; se deja en 0 durante el alta de los primeros usuarios.
AUTH_PROTEGER_DATOS=0
# Contraseña del primer usuario admin que siembra connector/seed_admin.mjs.
# Usar una vez y retirar del archivo.
SEED_PASS=

# --- Monitor de alertas vivas (opcional) ----------------------------- [nube]
# Secreto compartido con el que el agente local firma el POST de alertas.
MONITOR_PUSH_SECRET=
MONITOR_PUSH_URL=

# --- Publicación a Netlify (solo la máquina que publica) --------------------
# Token personal de Netlify usado por connector/publicar_semanas.sh.
# Rotar desde Netlify → User settings → Applications → Personal access tokens.
NETLIFY_AUTH_TOKEN=
NETLIFY_SITE_ID=

# --- Servidor local de desarrollo (opcional) --------------------------------
PORT=8080
